DATABASE_URL="postgresql://klikhubb:klikhubb@localhost:5432/klikhubb?schema=public"
# Producción (Neon): pega la URI con ?sslmode=require
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx.neon.tech/neondb?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Vercel producción:
# NEXTAUTH_URL=https://qlyk.vercel.app
# SITE_URL=https://qlyk.vercel.app
# DATABASE_URL es opcional: sin Postgres el login usa el modo demo.

# Opcional — Google OAuth (redirect: https://qlyk.vercel.app/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Opcional en local — Stripe Checkout (sk_test_… / whsec_…).
# En Vercel producción es obligatorio: sin STRIPE_SECRET_KEY el botón de compra no cobra.
# Webhook: https://qlyk.vercel.app/api/webhooks/stripe
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded, account.updated
# IMPORTANTE: usa el whsec_ del endpoint Test en Dashboard (Developers → Webhooks → Signing secret).
# NO uses stripe listen hacia producción: cada sesión genera otro whsec_ distinto.
# Si defines STRIPE_WEBHOOK_SECRET aquí, se sincroniza a Postgres en cada deploy/petición.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Opcional: forzar recreación del endpoint en Stripe (solo si NO tienes STRIPE_WEBHOOK_SECRET):
# STRIPE_WEBHOOK_SYNC=force
# Retiros automáticos a creadores/referidos (Stripe Connect Express).
# 1) Activa Connect en dashboard.stripe.com/settings/connect
# 2) Pon STRIPE_CONNECT_ENABLED=true
# 3) Añade account.updated al webhook en https://qlyk.vercel.app/api/webhooks/stripe
STRIPE_CONNECT_ENABLED=""
STRIPE_CONNECT_COUNTRY="MX"

# Videos: Vercel Blob (qlyk-videos). Sin token se puede pegar YouTube o un MP4 https.
BLOB_READ_WRITE_TOKEN=""

# Cron diario (Vercel): libera el hold de 14 días del monedero.
# En producción Vercel manda x-vercel-cron. Opcional: Authorization Bearer CRON_SECRET.
CRON_SECRET=""

# Token opcional para POST /api/admin/stripe-webhook-sync?force=1
# Authorization: Bearer <PLATFORM_SETUP_TOKEN>
PLATFORM_SETUP_TOKEN=""

# Opcional — datos legales (términos y privacidad)
LEGAL_ENTITY_NAME=""
LEGAL_TAX_ID=""
LEGAL_ADDRESS=""
LEGAL_CONTACT_EMAIL=""
LEGAL_PRIVACY_EMAIL=""
RESEND_API_KEY=""
EMAIL_FROM="Qlyk <hola@tudominio.com>"
