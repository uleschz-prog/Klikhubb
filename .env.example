DATABASE_URL="postgresql://klikhubb:klikhubb@localhost:5432/klikhubb?schema=public"
# Producción (Neon): pega la URI con ?sslmode=require
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx.neon.tech/neondb?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Vercel: NEXTAUTH_SECRET es obligatorio. NEXTAUTH_URL = https://tu-dominio.vercel.app
# DATABASE_URL es opcional: sin Postgres el login usa el modo demo.

# Opcional — Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Opcional en local — Stripe Checkout (sk_test_… / whsec_…).
# En Vercel producción es obligatorio: sin STRIPE_SECRET_KEY el botón de compra no cobra.
# Webhook: https://klikhubb.vercel.app/api/webhooks/stripe
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Retiros automáticos a creadores/referidos (Stripe Connect Express).
# 1) Activa Connect en dashboard.stripe.com/settings/connect
# 2) Pon STRIPE_CONNECT_ENABLED=true
# 3) Añade account.updated al webhook
STRIPE_CONNECT_ENABLED=""
STRIPE_CONNECT_COUNTRY="MX"

# Videos: Vercel Blob (qlyk-videos). Sin token se puede pegar YouTube o un MP4 https.
BLOB_READ_WRITE_TOKEN=""

# Cron diario (Vercel): libera el hold de 14 días del monedero.
# En producción Vercel manda x-vercel-cron. Opcional: Authorization Bearer CRON_SECRET.
CRON_SECRET=""

# Lista de espera: sin RESEND_API_KEY no se mandan correos (en local se guarda en /data).
# En resend.com verifica un dominio para escribir a cualquier email.
RESEND_API_KEY=""
EMAIL_FROM="Qlyk <hola@tudominio.com>"
WAITLIST_NOTIFY_EMAIL="tu@email.com"
