DATABASE_URL="postgresql://klikhubb:klikhubb@localhost:5432/klikhubb?schema=public"
NEXTAUTH_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Vercel producción:
# NEXTAUTH_URL=https://qlyk.vercel.app
# SITE_URL=https://qlyk.vercel.app

# Admin: en producción define esta clave o el usuario admin no se recrea con password por defecto.
PLATFORM_ADMIN_PASSWORD=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# Mercado Pago Checkout Pro (método principal en producción). Verificación: /admin/setup
# Credenciales: https://www.mercadopago.com.mx/developers/panel/app
