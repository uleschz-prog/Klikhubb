DATABASE_URL="postgresql://klikhubb:klikhubb@localhost:5432/klikhubb?schema=public"
# Producción (Neon): pega la URI con ?sslmode=require
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx.neon.tech/neondb?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Vercel: NEXTAUTH_SECRET es obligatorio. NEXTAUTH_URL = https://tu-dominio.vercel.app
# DATABASE_URL es opcional: sin Postgres el login usa el modo demo.

# Opcional — Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Opcional — Stripe Checkout. Sin estas claves el pago sigue en modo demo.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Videos: Vercel Blob para subir archivos. Sin token se puede pegar una URL https de un MP4.
BLOB_READ_WRITE_TOKEN=""

# Lista de espera: sin RESEND_API_KEY no se mandan correos (en local se guarda en /data).
# En resend.com verifica un dominio para escribir a cualquier email.
RESEND_API_KEY=""
EMAIL_FROM="KlikHubb <hola@tudominio.com>"
WAITLIST_NOTIFY_EMAIL="tu@email.com"
