MP_PUBLIC_KEY=""
# Secret de Webhooks (Tu integración → Webhooks). URL: https://TU_DOMINIO/api/webhooks/mercadopago
MP_WEBHOOK_SECRET=""
# Forzar sandbox_init_point aunque el token no empiece por TEST-
# MP_USE_SANDBOX="1"

# Pagos manuales SPEI (respaldo si no hay Mercado Pago). Verificación: /admin/setup
