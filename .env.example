DATABASE_URL="postgresql://klikhubb:klikhubb@localhost:5432/klikhubb?schema=public"
# Producción (Neon): pega la URI con ?sslmode=require
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx.neon.tech/neondb?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Vercel producción:
# NEXTAUTH_URL=https://qlyk.vercel.app
# SITE_URL=https://qlyk.vercel.app
# DATABASE_URL es opcional: sin Postgres el login usa el modo demo.

# Opcional — Google OAuth (redirect: https://qlyk.vercel.app/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe — producción Live en Vercel (https://qlyk.vercel.app)
# Guía completa: docs/stripe-live-vercel.md
# 1) Dashboard en modo Live → sk_live_… + webhook whsec_… (misma cuenta)
# 2) NO uses tarjeta 4242 en Live (solo Test)
# 3) NO uses stripe listen hacia producción
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Retiros a creadores/referidos (Stripe Connect Express) — obligatorio en Live si hay retiros
STRIPE_CONNECT_ENABLED="true"
STRIPE_CONNECT_COUNTRY="MX"
# Solo emergencia (recrear endpoint): STRIPE_WEBHOOK_SYNC=force — quitar después

# Videos: Vercel Blob (qlyk-videos). Sin token se puede pegar YouTube o un MP4 https.
BLOB_READ_WRITE_TOKEN=""

# Cron diario (Vercel): libera el hold de 14 días del monedero.
# En producción Vercel manda x-vercel-cron. Opcional: Authorization Bearer CRON_SECRET.
CRON_SECRET=""

# Token opcional para POST /api/admin/stripe-webhook-sync?force=1
# Authorization: Bearer <PLATFORM_SETUP_TOKEN>
PLATFORM_SETUP_TOKEN=""

# Opcional — datos legales (términos y privacidad)
LEGAL_ENTITY_NAME=""
LEGAL_TAX_ID=""
LEGAL_ADDRESS=""
LEGAL_CONTACT_EMAIL=""
LEGAL_PRIVACY_EMAIL=""
RESEND_API_KEY=""
EMAIL_FROM="Qlyk <hola@tudominio.com>"
