DATABASE_URL="postgresql://klikhubb:klikhubb@localhost:5432/klikhubb?schema=public"
NEXTAUTH_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Vercel producción:
# NEXTAUTH_URL=https://qlyk.vercel.app
# SITE_URL=https://qlyk.vercel.app

# Admin: en producción y previews es obligatorio. El fallback hardcodeado solo existe si NODE_ENV=development.
PLATFORM_ADMIN_PASSWORD=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Pagos: SPEI manual (producción, método actual). Verificación: /admin/setup
# REQUIRE_LIVE_PAYMENTS="1"  # fuerza cobro real (útil fuera de Vercel production)
# REQUIRE_LIVE_PAYMENTS="0"  # permite demo aunque VERCEL_ENV=production (nunca en live)

PAYMENT_BANK_NAME=""
PAYMENT_BENEFICIARY=""
PAYMENT_CLABE=""
PAYMENT_ACCOUNT_NUMBER=""

BLOB_READ_WRITE_TOKEN=""
# Obligatorio en producción. Vercel lo envía al cron como Authorization: Bearer $CRON_SECRET.
CRON_SECRET=""
PLATFORM_SETUP_TOKEN=""

# Identidad legal pública (términos y privacidad). Guía: docs/legal-setup-vercel.md
# Verificación: /admin/setup (como Qlykadmin)
# No subas RFC ni domicilio reales a este archivo (el repo es público).
LEGAL_ENTITY_NAME=""
LEGAL_TAX_ID=""
LEGAL_ADDRESS=""
LEGAL_CONTACT_EMAIL="qlykadmin@qlyk.app"
LEGAL_PRIVACY_EMAIL="privacidad@qlyk.app"

RESEND_API_KEY=""
EMAIL_FROM="Qlyk <hola@tudominio.com>"

# Tipo de cambio solo para *mostrar* precios en MXN (no se cobra con este valor).
# Si falta, la UI usa 18.5 y lo marca como aproximado. El PR de Mercado Pago
# puede reutilizar o reemplazar esta fuente con un FX en vivo.
# FX_USD_MXN="18.5"
