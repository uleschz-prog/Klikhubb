# Vercel producción:
# NEXTAUTH_URL=https://qlyk.vercel.app
# SITE_URL=https://qlyk.vercel.app

# Admin: en producción define esta clave o el usuario admin no se recrea con password por defecto.
PLATFORM_ADMIN_PASSWORD=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Pagos: Stripe (tarjeta) y/o SPEI (producción). Verificación: /admin/setup
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Webhook Stripe (producción): https://qlyk.vercel.app/api/webhooks/stripe
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
# invoice.paid, customer.subscription.deleted, account.updated, charge.refunded
# Connect (retiros a creadores): activo si hay STRIPE_SECRET_KEY.
# STRIPE_CONNECT_ENABLED="false"  # para apagar onboarding Express
# STRIPE_CONNECT_COUNTRY="MX"
# En Stripe Dashboard: Settings → Connect → Get started. Mismo webhook con account.updated y charge.refunded.
# REQUIRE_LIVE_PAYMENTS="1"  # fuerza cobro real (útil fuera de Vercel production)
# REQUIRE_LIVE_PAYMENTS="0"  # permite demo aunque VERCEL_ENV=production (nunca en live)

PAYMENT_BANK_NAME=""
PAYMENT_BENEFICIARY=""
PAYMENT_CLABE=""
PAYMENT_ACCOUNT_NUMBER=""

BLOB_READ_WRITE_TOKEN=""
CRON_SECRET=""
