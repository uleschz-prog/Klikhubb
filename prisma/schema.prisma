// =============================================================================
// KlikHubb — PostgreSQL / Prisma schema
// Diseñado para millones de usuarios, videos, órdenes y comunidad.
//
// Decisiones de escala:
// - IDs cuid() (no enumerables). El feed y el ledger nunca hacen COUNT(*).
// - Contadores desnormalizados en Video, Community y UserStats.
// - Invitación social de un nivel (User.invitedById). Sin árbol multinivel.
// - Ledgers append-only (Commission, WalletLedger, PointLedger). Nunca se
//   reescribe un monto; un clawback es una fila nueva de signo contrario.
// - VideoViewEvent es de alto volumen: en producción particionar por mes
//   (pg_partman) y archivar a cold storage. El feed lee viewCount, no esta tabla.
// - Money siempre Decimal(19,4). La lógica de negocio opera en centavos enteros.
// - Soft-delete vía status. No borrar Users con red activa.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum RoleCode {
  CREATOR
  STUDENT
  AFFILIATE
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum VideoStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum VideoLane {
  PLAY
  SHOP
}

enum ProductBilling {
  ONE_TIME
  MONTHLY
}

enum ProductType {
  DIGITAL
  PHYSICAL
  MEMBERSHIP
  COURSE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CHARGEBACK
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CommissionType {
  CREATOR_SALE
  DIRECT
  UNILEVEL
  BINARY
  MATCHING
  OVERRIDE
}

enum CommissionStatus {
  PENDING
  LOCKED
  APPROVED
  PAID
  CLAWED_BACK
}

enum LedgerType {
  SALE
  COMMISSION
  FEE
  PAYOUT
  REFUND
  CLAWBACK
  ADJUSTMENT
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BinaryLeg {
  LEFT
  RIGHT
}

enum CommunityRole {
  OWNER
  MODERATOR
  MEMBER
}

enum PostType {
  DISCUSSION
  ANNOUNCEMENT
  QUESTION
  WIN
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  REVOKED
}

enum PointReason {
  VIDEO_WATCH
  PURCHASE
  REFERRAL
  POST
  STREAK
  RANK_UP
  REWARD_REDEEM
}

enum RewardType {
  BADGE
  PAYOUT_BONUS
  ACCESS
  PHYSICAL
}

// ---------------------------------------------------------------------------
// Auth (NextAuth Prisma Adapter) + Users
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  username      String?    @unique
  hashedPassword String?
  displayName   String?
  bio           String?    @db.VarChar(280)
  locale        String     @default("es")
  timezone      String     @default("UTC")
  status        UserStatus @default(PENDING)
  kycStatus     KycStatus  @default(NONE)
  referralCode  String     @unique @default(cuid())
  invitedById   String?
  stripeAccountId      String? @unique
  stripePayoutsEnabled Boolean @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts Account[]
  sessions Session[]
  roles    UserRole[]

  videos   Video[]
  products Product[]

  ordersBought     Order[] @relation("OrdersBought")
  ordersSold       Order[] @relation("OrdersSold")
  affiliateOrders  Order[] @relation("OrdersAffiliated")

  commissionsEarned Commission[] @relation("CommissionsEarned")
  commissionsSourced Commission[] @relation("CommissionsSourced")

  networkNode NetworkNode?
  wallet      Wallet?
  walletLedger WalletLedger[]
  payouts     Payout[]

  communitiesOwned     Community[]
  communityMemberships CommunityMember[]
  communityPosts       CommunityPost[]
  postLikes            PostLike[]

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")
  invitedBy    User?  @relation("InvitedUsers", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[] @relation("InvitedUsers")

  enrollments   Enrollment[]
  productSubscriptions ProductSubscription[]
  videoLikes    VideoLike[]
  videoSaves    VideoSave[]
  videoComments VideoComment[]
  videoViews    VideoViewEvent[]

  stats        UserStats?
  pointLedger  PointLedger[]
  userRewards  UserReward[]
  rankHistory  UserRankHistory[]

  @@index([status, createdAt])
  @@index([kycStatus])
  @@index([invitedById])
  @@map("users")
}

model UserRole {
  userId    String
  role      RoleCode
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Social graph
// ---------------------------------------------------------------------------

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
  @@map("follows")
}

// ---------------------------------------------------------------------------
// Videos (descubrimiento viral)
// ---------------------------------------------------------------------------

model Video {
  id           String      @id @default(cuid())
  creatorId    String
  title        String      @db.VarChar(120)
  caption      String?     @db.VarChar(500)
  playbackId   String?
  videoUrl     String?
  thumbnailUrl String?
  durationMs   Int?
  status       VideoStatus @default(DRAFT)
  viewCount    Int         @default(0)
  likeCount    Int         @default(0)
  commentCount Int         @default(0)
  shareCount   Int         @default(0)
  saveCount    Int         @default(0)
  lane         VideoLane   @default(SHOP)
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  creator  User           @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  products VideoProduct[]
  likes    VideoLike[]
  saves    VideoSave[]
  comments VideoComment[]
  views    VideoViewEvent[]
  tags     VideoTag[]
  lessons  Lesson[]

  @@index([status, publishedAt(sort: Desc)], map: "videos_feed_idx")
  @@index([status, lane, publishedAt(sort: Desc)], map: "videos_lane_feed_idx")
  @@index([creatorId, publishedAt(sort: Desc)])
  @@map("videos")
}

model VideoProduct {
  videoId   String
  productId String
  isPrimary Boolean @default(false)
  ctaLabel  String  @default("Comprar ahora")
  sortOrder Int     @default(0)

  video   Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([videoId, productId])
  @@index([productId])
  @@map("video_products")
}

model VideoLike {
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([videoId, userId])
  @@index([userId])
  @@map("video_likes")
}

model VideoSave {
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([videoId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("video_saves")
}

model VideoComment {
  id        String   @id @default(cuid())
  videoId   String
  authorId  String
  parentId  String?
  body      String   @db.VarChar(2000)
  likeCount Int      @default(0)
  createdAt DateTime @default(now())

  video  Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent VideoComment?  @relation("VideoCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies VideoComment[] @relation("VideoCommentThread")

  @@index([videoId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@map("video_comments")
}

/// Evento de reproducción. NO consultar para el feed.
/// Producción: PARTITION BY RANGE (created_at) mensual.
model VideoViewEvent {
  id        String   @id @default(cuid())
  videoId   String
  viewerId  String?
  watchMs   Int      @default(0)
  completed Boolean  @default(false)
  source    String?
  createdAt DateTime @default(now())

  video  Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  viewer User? @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([videoId, createdAt])
  @@index([viewerId, createdAt])
  @@map("video_view_events")
}

model Tag {
  id         String @id @default(cuid())
  slug       String @unique
  name       String
  videoCount Int    @default(0)
  videos     VideoTag[]

  @@map("tags")
}

model VideoTag {
  videoId String
  tagId   String
  video   Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@index([tagId])
  @@map("video_tags")
}

// ---------------------------------------------------------------------------
// Products / Courses / Academy
// ---------------------------------------------------------------------------

model Product {
  id             String        @id @default(cuid())
  creatorId      String
  type           ProductType
  title          String
  slug           String        @unique
  description    String        @db.Text
  price          Decimal       @db.Decimal(19, 4)
  compareAtPrice Decimal?      @db.Decimal(19, 4)
  currency       String        @db.Char(3) @default("USD")
  status         ProductStatus @default(DRAFT)
  billing        ProductBilling @default(ONE_TIME)
  affiliateRate  Decimal       @default(0.20) @db.Decimal(7, 6)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  creator    User           @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  videos     VideoProduct[]
  course     Course?
  community  Community?
  orderItems OrderItem[]
  enrollments Enrollment[]
  subscriptions ProductSubscription[]

  @@index([creatorId, status])
  @@index([status, type])
  @@map("products")
}

model Course {
  id              String @id @default(cuid())
  productId       String @unique
  level           String?
  totalDurationMs Int    @default(0)
  lessonCount     Int    @default(0)
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  modules         CourseModule[]

  @@map("courses")
}

model CourseModule {
  id        String @id @default(cuid())
  courseId  String
  title     String
  sortOrder Int    @default(0)
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId, sortOrder])
  @@map("course_modules")
}

model Lesson {
  id             String  @id @default(cuid())
  moduleId       String
  title          String
  videoId        String?
  content        String? @db.Text
  /// Archivo descargable (PDF, ZIP, etc.) — independiente del video de la lección.
  resourceUrl    String?
  resourceName   String?
  durationMs     Int?
  sortOrder      Int     @default(0)
  isFreePreview  Boolean @default(false)
  module         CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  video          Video?       @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@index([moduleId, sortOrder])
  @@map("lessons")
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  productId   String
  orderId     String?
  status      EnrollmentStatus @default(ACTIVE)
  progressPct Decimal          @default(0) @db.Decimal(5, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscription ProductSubscription?

  @@unique([userId, productId])
  @@index([productId, status])
  @@map("enrollments")
}

model ProductSubscription {
  id                   String    @id @default(cuid())
  userId                 String
  productId              String
  enrollmentId           String?   @unique
  stripeSubscriptionId   String    @unique
  stripeCustomerId       String?
  status                 String
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([productId, status])
  @@map("product_subscriptions")
}

// ---------------------------------------------------------------------------
// Commerce — Orders + Payments + Commission ledger
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  buyerId     String
  sellerId    String
  affiliateId String?
  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(19, 4)
  fees        Decimal     @default(0) @db.Decimal(19, 4)
  tax         Decimal     @default(0) @db.Decimal(19, 4)
  total       Decimal     @db.Decimal(19, 4)
  currency    String      @db.Char(3) @default("USD")
  paidAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  buyer     User  @relation("OrdersBought", fields: [buyerId], references: [id], onDelete: Restrict)
  seller    User  @relation("OrdersSold", fields: [sellerId], references: [id], onDelete: Restrict)
  affiliate User? @relation("OrdersAffiliated", fields: [affiliateId], references: [id], onDelete: SetNull)

  items        OrderItem[]
  payments     Payment[]
  commissions  Commission[]
  enrollments  Enrollment[]
  walletLedger WalletLedger[]

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([sellerId, status, createdAt(sort: Desc)])
  @@index([affiliateId, createdAt(sort: Desc)])
  @@index([status, paidAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(19, 4)
  total     Decimal @db.Decimal(19, 4)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  provider    String
  providerRef String?
  amount      Decimal       @db.Decimal(19, 4)
  currency    String        @db.Char(3) @default("USD")
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@unique([provider, providerRef])
  @@map("payments")
}

model Commission {
  id             String           @id @default(cuid())
  orderId        String
  beneficiaryId  String
  sourceUserId   String
  networkNodeId  String?
  type           CommissionType
  level          Int              @default(0)
  rate           Decimal          @db.Decimal(7, 6)
  amount         Decimal          @db.Decimal(19, 4)
  currency       String           @db.Char(3) @default("USD")
  status         CommissionStatus @default(PENDING)
  availableAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime         @default(now())

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  beneficiary  User         @relation("CommissionsEarned", fields: [beneficiaryId], references: [id], onDelete: Restrict)
  sourceUser   User         @relation("CommissionsSourced", fields: [sourceUserId], references: [id], onDelete: Restrict)
  networkNode  NetworkNode? @relation(fields: [networkNodeId], references: [id], onDelete: SetNull)
  walletLedger WalletLedger[]

  @@index([beneficiaryId, status, createdAt(sort: Desc)], map: "commissions_payee_idx")
  @@index([orderId])
  @@index([sourceUserId, createdAt])
  @@index([type, status])
  @@map("commissions")
}

model Wallet {
  userId          String  @id
  available       Decimal @default(0) @db.Decimal(19, 4)
  pending         Decimal @default(0) @db.Decimal(19, 4)
  lifetimeEarned  Decimal @default(0) @db.Decimal(19, 4)
  currency        String  @db.Char(3) @default("USD")
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletLedger {
  id           String     @id @default(cuid())
  userId       String
  amount       Decimal    @db.Decimal(19, 4)
  balanceAfter Decimal    @db.Decimal(19, 4)
  type         LedgerType
  commissionId String?
  orderId      String?
  payoutId     String?
  note         String?
  createdAt    DateTime   @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  commission Commission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payout     Payout?     @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt])
  @@map("wallet_ledger")
}

model Payout {
  id           String       @id @default(cuid())
  userId       String
  amount       Decimal      @db.Decimal(19, 4)
  currency     String       @db.Char(3) @default("USD")
  method       String
  status       PayoutStatus @default(PENDING)
  providerRef  String?      @unique
  completedAt  DateTime?
  failureNote  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledger WalletLedger[]

  @@index([userId, status, createdAt])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// Platform secrets (Stripe webhook signing secret, etc.)
// ---------------------------------------------------------------------------

model PlatformSecret {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("platform_secrets")
}

// ---------------------------------------------------------------------------
// MLM — unilevel + binario + plan de compensación
// ---------------------------------------------------------------------------

model NetworkNode {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  sponsorId String?
  sponsor   NetworkNode?  @relation("UnilevelDownline", fields: [sponsorId], references: [id], onDelete: SetNull)
  recruits  NetworkNode[] @relation("UnilevelDownline")

  placementParentId String?
  placementParent   NetworkNode?  @relation("BinaryPlacement", fields: [placementParentId], references: [id], onDelete: SetNull)
  placedChildren    NetworkNode[] @relation("BinaryPlacement")
  binaryPosition    BinaryLeg?

  /// Materialized path: "rootId.childId.thisId" — no usar LIKE '%x'; usar prefix query.
  path  String
  depth Int    @default(0)

  personalVolume Decimal @default(0) @db.Decimal(19, 4)
  groupVolume    Decimal @default(0) @db.Decimal(19, 4)
  leftLegVolume  Decimal @default(0) @db.Decimal(19, 4)
  rightLegVolume Decimal @default(0) @db.Decimal(19, 4)

  rankId String?
  rank   Rank?   @relation(fields: [rankId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ancestorOf     NetworkClosure[] @relation("ClosureAncestors")
  descendantOf   NetworkClosure[] @relation("ClosureDescendants")
  commissions    Commission[]

  @@unique([placementParentId, binaryPosition])
  @@index([sponsorId])
  @@index([placementParentId])
  @@index([path])
  @@index([rankId])
  @@index([depth])
  @@map("network_nodes")
}

/// Cierre transitivo del árbol unilevel. Insertar O(depth) filas al enrolar.
/// Downline de A: WHERE ancestor_id = A. Upline de B: WHERE descendant_id = B.
model NetworkClosure {
  ancestorId   String
  descendantId String
  depth        Int

  ancestor   NetworkNode @relation("ClosureAncestors", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant NetworkNode @relation("ClosureDescendants", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId, depth])
  @@index([ancestorId, depth])
  @@map("network_closure")
}

model CompensationPlan {
  id               String  @id @default(cuid())
  code             String  @unique
  name             String
  maxUnilevelDepth Int     @default(5)
  binaryEnabled    Boolean @default(true)
  platformFeeRate  Decimal @db.Decimal(7, 6)
  creatorRate      Decimal @db.Decimal(7, 6)
  holdDays         Int     @default(14)
  isActive         Boolean @default(true)
  levels           CommissionLevel[]

  @@map("compensation_plans")
}

model CommissionLevel {
  id     String          @id @default(cuid())
  planId String
  level  Int
  type   CommissionType
  rate   Decimal         @db.Decimal(7, 6)
  plan   CompensationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, level, type])
  @@map("commission_levels")
}

// ---------------------------------------------------------------------------
// Community
// ---------------------------------------------------------------------------

model Community {
  id          String  @id @default(cuid())
  ownerId     String
  productId   String? @unique
  name        String
  slug        String  @unique
  description String  @db.Text
  memberCount Int     @default(0)
  isPaid      Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  product Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  members CommunityMember[]
  posts   CommunityPost[]

  @@index([ownerId])
  @@map("communities")
}

model CommunityMember {
  communityId String
  userId      String
  role        CommunityRole @default(MEMBER)
  points      Int           @default(0)
  joinedAt    DateTime      @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId])
  @@map("community_members")
}

model CommunityPost {
  id            String   @id @default(cuid())
  communityId   String
  authorId      String
  parentId      String?
  type          PostType @default(DISCUSSION)
  title         String?  @db.VarChar(200)
  body          String   @db.Text
  likeCount     Int      @default(0)
  commentCount  Int      @default(0)
  pointsAwarded Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  community Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    CommunityPost?  @relation("PostThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityPost[] @relation("PostThread")
  likes     PostLike[]

  @@index([communityId, createdAt(sort: Desc)], map: "community_posts_feed_idx")
  @@index([authorId, createdAt])
  @@index([parentId])
  @@map("community_posts")
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_likes")
}

// ---------------------------------------------------------------------------
// Gamification — ranks, points, rewards
// ---------------------------------------------------------------------------

model Rank {
  id                 String  @id @default(cuid())
  slug               String  @unique
  name               String
  minPersonalVolume  Decimal @default(0) @db.Decimal(19, 4)
  minGroupVolume     Decimal @default(0) @db.Decimal(19, 4)
  minDirectRecruits  Int     @default(0)
  sortOrder          Int     @unique
  nodes              NetworkNode[]
  history            UserRankHistory[]
  stats              UserStats[]
  rewards            Reward[]

  @@map("ranks")
}

model UserRankHistory {
  id         String   @id @default(cuid())
  userId     String
  rankId     String
  achievedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank Rank @relation(fields: [rankId], references: [id], onDelete: Restrict)

  @@index([userId, achievedAt(sort: Desc)])
  @@map("user_rank_history")
}

model Reward {
  id          String     @id @default(cuid())
  name        String
  description String     @db.Text
  pointsCost  Int?
  rankId      String?
  type        RewardType
  isActive    Boolean    @default(true)
  rank        Rank?      @relation(fields: [rankId], references: [id], onDelete: SetNull)
  grants      UserReward[]

  @@index([isActive, type])
  @@map("rewards")
}

model UserReward {
  userId    String
  rewardId  String
  grantedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@id([userId, rewardId])
  @@map("user_rewards")
}

model PointLedger {
  id           String      @id @default(cuid())
  userId       String
  delta        Int
  balanceAfter Int
  reason       PointReason
  refType      String?
  refId        String?
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([reason, createdAt])
  @@map("point_ledger")
}

model UserStats {
  userId           String   @id
  points           Int      @default(0)
  rankId           String?
  streakDays       Int      @default(0)
  lastActivityDate DateTime?
  videosPublished  Int      @default(0)
  totalSales       Decimal  @default(0) @db.Decimal(19, 4)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank Rank? @relation(fields: [rankId], references: [id], onDelete: SetNull)

  @@index([points(sort: Desc)], map: "user_stats_leaderboard_idx")
  @@index([rankId])
  @@map("user_stats")
}
